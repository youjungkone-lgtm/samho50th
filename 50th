      1976 - 2026 희년의 기쁨과 감사를 온 교우와 함께 나눕니다.
    </p>
  </footer>

  <!-- 알림 토스트 메시지 -->
  <div id="toastNotification" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 bg-stone-900/90 backdrop-blur text-white px-5 py-3 rounded-full text-xs font-semibold shadow-2xl flex items-center gap-2 transition-all duration-300 opacity-0 pointer-events-none translate-y-3">
    <i class="fa-solid fa-circle-check text-amber-400"></i>
    <span id="toastText">링크가 복사되었습니다.</span>
  </div>

  <!-- 비상 연락망 모달 다이얼로그 -->
  <div id="modalEmergency" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-5 max-w-xs w-full shadow-2xl space-y-4">
      <div class="flex items-center justify-between border-b border-stone-100 pb-3">
        <h3 class="font-extrabold text-stone-900 text-sm flex items-center gap-1.5">
          <i class="fa-solid fa-headset text-rose-600"></i> 행사 당일 비상 연락망
        </h3>
        <button onclick="closeEmergencyModal()" class="text-stone-400 hover:text-stone-600 p-1">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>

      <div class="space-y-2 text-xs">
        <div class="p-3 bg-stone-50 rounded-2xl border border-stone-200 flex justify-between items-center">
          <div>
            <div class="font-bold text-stone-800">현장 안전 총괄</div>
            <div class="text-[11px] text-stone-500">정영식 안수집사</div>
          </div>
          <span class="text-xs font-bold text-rose-700 bg-rose-50 px-2.5 py-1 rounded-full border border-rose-200">안전팀</span>
        </div>

        <div class="p-3 bg-stone-50 rounded-2xl border border-stone-200 flex justify-between items-center">
          <div>
            <div class="font-bold text-stone-800">차량 및 수송</div>
            <div class="text-[11px] text-stone-500">이상욱 안수집사</div>
          </div>
          <span class="text-xs font-bold text-amber-700 bg-amber-50 px-2.5 py-1 rounded-full border border-amber-200">차량팀</span>
        </div>

        <div class="p-3 bg-stone-50 rounded-2xl border border-stone-200 flex justify-between items-center">
          <div>
            <div class="font-bold text-stone-800">행사 진행 본부</div>
            <div class="text-[11px] text-stone-500">잔디광장 운영 부스</div>
          </div>
          <span class="text-xs font-bold text-purple-700 bg-purple-50 px-2.5 py-1 rounded-full border border-purple-200">운영본부</span>
        </div>
      </div>

      <button onclick="closeEmergencyModal()" class="w-full py-3 rounded-2xl bg-stone-900 text-white font-bold text-xs active:scale-[0.99] transition">
        닫기
      </button>
    </div>
  </div>

  <script>
    // 교통편 탭 전환 함수
    function changeTransportTab(mode) {
      const btnBus = document.getElementById('btnTabBus');
      const btnCar = document.getElementById('btnTabCar');
      const contentBus = document.getElementById('contentBus');
      const contentCar = document.getElementById('contentCar');

      if (mode === 'bus') {
        btnBus.className = "py-2.5 rounded-xl transition-all duration-200 bg-white text-stone-900 shadow-sm flex items-center justify-center gap-1.5";
        btnCar.className = "py-2.5 rounded-xl transition-all duration-200 text-stone-500 hover:text-stone-800 flex items-center justify-center gap-1.5";
        contentBus.classList.remove('hidden');
        contentCar.classList.add('hidden');
      } else {
        btnCar.className = "py-2.5 rounded-xl transition-all duration-200 bg-white text-stone-900 shadow-sm flex items-center justify-center gap-1.5";
        btnBus.className = "py-2.5 rounded-xl transition-all duration-200 text-stone-500 hover:text-stone-800 flex items-center justify-center gap-1.5";
        contentCar.classList.remove('hidden');
        contentBus.classList.add('hidden');
      }
    }

    // 토스트 팝업 표시
    function showNotification(msg) {
      const toast = document.getElementById('toastNotification');
      const text = document.getElementById('toastText');
      text.textContent = msg;
      toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
      toast.classList.add('opacity-100', 'translate-y-0');

      setTimeout(() => {
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
      }, 2500);
    }

    // 클립보드 공유 링크 복사 (iframe 및 모바일 호환 document.execCommand 방식)
    function shareLink() {
      const dummy = document.createElement('textarea');
      dummy.value = window.location.href;
      document.body.appendChild(dummy);
      dummy.select();
      try {
        document.execCommand('copy');
        showNotification('목장 단체방에 전달할 안내 링크가 복사되었습니다!');
      } catch (err) {
        showNotification('안내 링크 복사 준비가 완료되었습니다.');
      }
      document.body.removeChild(dummy);
    }

    // 비상 연락망 모달 열기/닫기
    function openEmergencyModal() {
      document.getElementById('modalEmergency').classList.remove('hidden');
    }
    function closeEmergencyModal() {
      document.getElementById('modalEmergency').classList.add('hidden');
    }
  </script>
</body>
</html>
